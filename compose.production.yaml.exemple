services:
  traefik:
    image: traefik:v3.7
    command:
      - "--api.insecure=true"
      - "--providers.docker=true"
      - "--entrypoints.web.address=:80"
    ports:
      - "80:80"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

  api:
    image: amin/api:0.2.0
    build:
      dockerfile: Dockerfile
      target: production
    labels:
      traefik.enable: true
      traefik.http.routers.api.rule: Host(`api.localhost`)
